{
  "name": "@quan-erp-plugins/sample-es-backend",
  "version": "1.0.0",
  "description": "Sample Quan ERP plugin backend",
  "main": "dist/index.js",
  "scripts": {
    "release:beta": "npm publish --tag beta",
    "build:prod": "MODE=prod rollup -c && cp -r ./assets dist/",
    "build:dev": "MODE=dev rollup -c && cp -r ./assets dist/",
    "build:export": "MODE=export rollup -c && rm -r dist/assets",
    "migration:generate": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:generate src/migrations -d src/migrations/source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bundle": {
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@quan-erp/shared-backend-core": "^1.0.4",
    "@quan-erp/shared-types": "^1.0.4",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "express": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  }
}